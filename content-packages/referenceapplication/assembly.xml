<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
                              http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>assemble-content</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <!-- content.properties must sit at the root of the archive: the OpenMRS SDK
             reads it to learn the package's name, its version, its content package
             dependencies (which fix install ordering) and its `var.` defaults. A
             malformed outputDirectory here silently drops it, and the SDK then warns
             "No content.properties found" and installs the package unordered. -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <includes>
                <include>content.properties</include>
            </includes>
            <outputDirectory>.</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/configuration</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
