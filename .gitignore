**/target/
**/.DS_Store
**/node_modules/
**/node
*.iml
.idea/

# Secrets and local deployment configuration.
# `.env` holds database credentials and must never be committed.
.env
.env.*
!.env.example

# Pre-populated database dumps. Regenerated by .github/workflows/build-db-seed.yml.
# A dump contains a full copy of a database, including any PHI, so it is never
# committed even in a development environment.
deployment/db/seed.sql
*.sql.gz
!deployment/db/purge-demo-data.sql
dump.sql

# Generated frontend/serving artefacts.
frontend/src/main/resources/*
!frontend/src/main/resources/.gitkeep
gateway/*.conf

# LLM coding agent documentation
CLAUDE.md
.claude/
.cursorrules
.cursor/
.aider*
.clinerules

# Local build logs from long-running image builds.
.build-logs/
