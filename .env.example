# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored and MUST NOT be committed.
#
#   cp .env.example .env
#
# Nothing in this file is a real credential. Every value below is either a public
# image reference or a placeholder you must replace before running anything that
# is reachable by anyone but you.
# ---------------------------------------------------------------------------

# --- distribution identity ---------------------------------------------------
# The version of THIS repository. Used to tag locally built images and to select
# the matching database seed.
OMRS_DISTRO_VERSION=3.7.1

# --- naming ------------------------------------------------------------------
# Prefix for container and volume names. Compose would otherwise derive them from
# the directory name, which is long, gets truncated, and changes if the checkout
# is moved -- producing names like
# `openmrs-distro-referenceapplication-371-db-1` and
# `openmrs-distro-referenceapplication-371_db-data`.
#
# With this set, `docker ps` and `docker volume ls` read consistently:
#
#   omrs-backend, omrs-db, omrs-frontend, omrs-gateway, omrs-db-init
#   omrs-db-data (clinical record), omrs-openmrs-data (uploads, config state)
#
# CHANGE THIS WITH CARE. It is part of the volume name, not just a label, so
# changing it on an existing deployment creates a second, empty set of volumes
# instead of reusing the live ones. The old volumes are then not referenced by
# anything and `docker volume ls` shows both sets. Either keep it constant, or
# migrate the data deliberately. Set a distinct value (e.g. omrs-staging) to run
# a second copy of this stack on one host.
OMRS_NAME_PREFIX=omrs

# --- images -------------------------------------------------------------------
# Pinned by digest or by an explicit version tag. To move to a new upstream
# release: change the tag, resolve the new digest with
# `docker buildx imagetools inspect <ref>`, and update OMRS_DB_SEED_IMAGE in the
# same commit so the database and the backend stay on the same release line.
#
# The database server. Pinned to the exact digest this distribution was validated
# against. Replace it together with OMRS_DB_SEED_IMAGE when changing release lines,
# never on its own.
OMRS_MARIADB_IMAGE=mariadb:10.11.7@sha256:27292753bb759cd22be72e3c8192f1259ef47010c8634b5da0bc886845efe9fd

# Stack images. When you build from this repository, tag the results with
# OMRS_DISTRO_VERSION so these references resolve to your own build:
#   docker compose -f docker-compose.yml -f docker-compose.build.yml build
OMRS_BACKEND_IMAGE=openmrs/openmrs-reference-application-3-backend:3.7.1-no-demo
OMRS_FRONTEND_IMAGE=openmrs/openmrs-reference-application-3-frontend:3.7.1
OMRS_GATEWAY_IMAGE=openmrs/openmrs-reference-application-3-gateway:3.7.1

# --- pre-populated database seed (site/deployment) ---------------------------
# Produced by .github/workflows/build-db-seed.yml from this repository, so the
# database and the backend always come from the same release line.
OMRS_DB_SEED_IMAGE=ghcr.io/intuvance/openmrs-db-seed:3.7.1

# Set to false to skip the pre-populated seed entirely. The database will then be
# built by the Initializer from the official Reference Application content package
# at first startup. Slower to first readiness, but fully reproducible from source
# with no prebuilt artifact. Useful for air-gapped builds where you want to
# generate the dump yourself.
OMRS_DB_SEED_ENABLED=true

# Only set this when deliberately pointing OMRS_DB_SEED_IMAGE at a raw, unsanitised
# upstream image such as openmrs/openmrs-reference-application-3-db:nightly-with-data.
# It runs deployment/db/purge-demo-data.sql against the freshly restored database.
# Leave false for the published seed image, which is already sanitised.
OMRS_DB_PURGE_AFTER_SEED=false

# The account baked into the upstream seed image. Public knowledge, not a secret;
# present only so seed.sh can revoke it.
OMRS_DB_SEED_USER=openmrs
OMRS_DB_SEED_PASSWORD=openmrs

# --- secrets (REPLACE ALL OF THESE) ------------------------------------------
# Generate with:  openssl rand -base64 32
# These have no usable default on purpose. A deployment that has not replaced them
# will fail to start rather than come up with a publicly known password.
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=CHANGE_ME_OMRS_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# --- database ----------------------------------------------------------------
OMRS_DB_NAME=openmrs
OMRS_DB_POOL_SIZE=50

# --- OpenMRS -----------------------------------------------------------------
# The frontend configuration the Initializer writes from the site content package.
OMRS_SPA_CONFIG_URLS=/openmrs/spa/config-core.json
OMRS_SPA_DEFAULT_LOCALE=en

# Set to false on constrained hardware. A search index rebuild on every boot makes
# restarts slow; the system is fully usable without it.
OMRS_CONFIG_SCHEDULER_STARTUP=false

OMRS_SESSION_TIMEOUT=3600

# The REST base URL the backend advertises to clients. Leave empty when TLS
# terminates at the gateway on the same host; set it to the public https:// URL
# otherwise, otherwise generated links in the UI and emails will be http://.
OMRS_REST_PROXY=

# --- network -----------------------------------------------------------------
# Host port for the gateway. Only the gateway is ever published; the database and
# the backend stay on the internal compose network.
OMRS_HTTP_PORT=8080
